#!/bin/bash
#
# Pre-commit hook: duplicate/anti-pattern scan, then the unit suite.
# Install: cp scripts/hooks/pre-commit-duplicates .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or add to existing pre-commit: source scripts/hooks/pre-commit-duplicates
#
# Configuration via environment:
#   SKIP_DUPLICATE_CHECK=1   Skip duplicate checking
#   DUPLICATE_VERBOSE=1      Show verbose output
#   SKIP_TESTS=1             Skip the unit suite only
#

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Get the repo root
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    echo -e "${RED}Error: Not a git repository${NC}"
    exit 1
fi

cd "$REPO_ROOT"

# ---- Duplicate / anti-pattern scan ------------------------------------------
duplicate_check() {
# Check if the scanner exists
if [ ! -f "scripts/hooks/check-duplicates.php" ]; then
    echo -e "${YELLOW}Warning: Duplicate scanner not found, skipping check${NC}"
    return 0
fi

# Build options
OPTIONS="--quick"
if [ "$DUPLICATE_VERBOSE" = "1" ]; then
    OPTIONS="$OPTIONS --verbose"
fi

echo -e "${YELLOW}Running duplicate code check...${NC}"

# Run the scanner and capture output
OUTPUT=$(php scripts/hooks/check-duplicates.php $OPTIONS 2>&1)
EXIT_CODE=$?

# Check for critical violations
if echo "$OUTPUT" | grep -q "\[CRITICAL\]"; then
    CRITICAL_COUNT=$(echo "$OUTPUT" | grep -c "\[CRITICAL\]")
    echo -e "${RED}================================${NC}"
    echo -e "${RED}COMMIT BLOCKED: Critical code patterns detected!${NC}"
    echo -e "${RED}================================${NC}"
    echo ""
    # Show only critical issues
    echo "$OUTPUT" | grep -A 10 "\[CRITICAL\]"
    echo ""
    echo -e "${RED}Please fix these critical issues before committing.${NC}"
    echo -e "Run: ${YELLOW}php scripts/hooks/check-duplicates.php --verbose${NC} for details."
    echo -e "To skip this check: ${YELLOW}SKIP_DUPLICATE_CHECK=1 git commit${NC}"
    exit 1
fi

# Warn about high severity issues but don't block
if echo "$OUTPUT" | grep -q "\[HIGH\]"; then
    HIGH_COUNT=$(echo "$OUTPUT" | grep -c "\[HIGH\]")
    echo -e "${YELLOW}================================${NC}"
    echo -e "${YELLOW}Warning: High severity patterns detected${NC}"
    echo -e "${YELLOW}================================${NC}"
    echo ""
    # Show only high issues
    echo "$OUTPUT" | grep -A 5 "\[HIGH\]" | head -30
    echo ""
    echo -e "${YELLOW}Consider fixing these issues. Commit will proceed.${NC}"
fi

echo -e "${GREEN}Duplicate check passed!${NC}"
return 0
}

if [ "$SKIP_DUPLICATE_CHECK" = "1" ]; then
    echo -e "${YELLOW}Skipping duplicate code check (SKIP_DUPLICATE_CHECK=1)${NC}"
else
    duplicate_check || exit 1
fi

# ---- Unit tests -------------------------------------------------------------
# tests/run.sh (phpunit over tests/unit/). About a second; touches nothing live.
# A red suite blocks the commit. A missing phpunit blocks too, and says how to
# get it — a hook that skips the tests because the runner is absent would pass
# every commit on exactly the checkout that cannot check anything.
#   SKIP_TESTS=1 git commit     to bypass (say why in the commit message)
if [ "$SKIP_TESTS" = "1" ]; then
    echo -e "${YELLOW}Skipping unit tests (SKIP_TESTS=1)${NC}"
    exit 0
fi
if [ ! -x "tests/run.sh" ]; then
    echo -e "${RED}COMMIT BLOCKED: tests/run.sh is missing or not executable.${NC}"
    exit 1
fi
echo -e "${YELLOW}Running unit tests...${NC}"
TEST_OUTPUT=$(tests/run.sh 2>&1)
TEST_EXIT=$?
if [ $TEST_EXIT -ne 0 ]; then
    echo -e "${RED}================================${NC}"
    echo -e "${RED}COMMIT BLOCKED: unit tests failed (exit $TEST_EXIT)${NC}"
    echo -e "${RED}================================${NC}"
    echo ""
    echo "$TEST_OUTPUT" | tail -40
    echo ""
    echo -e "Run: ${YELLOW}tests/run.sh${NC} for the full output."
    echo -e "To skip: ${YELLOW}SKIP_TESTS=1 git commit${NC}"
    exit 1
fi
echo -e "${GREEN}$(echo "$TEST_OUTPUT" | grep -E '^OK \(' || echo 'Unit tests passed')${NC}"
exit 0
