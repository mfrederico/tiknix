# Copy to .env (gitignored) and fill in. Nothing here is ever committed.

E2E_BASE_URL=https://tiknix.com
E2E_USER=admin
E2E_PASS=

# Opt-in publish targets. Off by default: a hosted deploy spends hypervisor capacity and
# a GitHub push spends a real repo. The suite always exercises the local rsync target.
#E2E_HOSTED=1
#E2E_GITHUB=1

# rsync destination the disposable project publishes to.
#E2E_RSYNC_HOST=localhost
#E2E_RSYNC_USER=ubuntu
#E2E_RSYNC_PATH=/var/www/html/default/test-destination-rsync.tiknix

# Web-server logs are usually root-owned; list them here if this runner can read them.
#E2E_EXTRA_LOGS=/var/log/nginx/error.log,/usr/local/openresty/nginx/logs/error.log
