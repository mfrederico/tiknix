{
    "name": "tiknix/runtime",
    "description": "The tiknix runtime: what every tiknix app runs on — routing, the Bean ORM wrapper, members and auth, the admin, connections and connectors, pipelines, the MCP server, plugins (concepts), and the agent runner. An app requires it and overrides a file by putting its own at the same path (see Paths, Overrides).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "bacon/bacon-qr-code": "^3.0",
        "fastmcphp/fastmcphp": "^0.1",
        "flightphp/core": "^3.19.3",
        "gabordemooij/redbean": "^5.7",
        "mailgun/mailgun-php": "^4.0",
        "monolog/monolog": "^3.5",
        "nyholm/psr7": "^1.5",
        "pragmarx/google2fa": "^8.0",
        "symfony/http-client": "^6.0",
        "symfony/yaml": "^8.1",
        "translatify/translatify": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "app\\": ["controls/", "lib/"],
            "app\\BaseControls\\": "controls/BaseControls/",
            "app\\mcptools\\": "mcptools/",
            "app\\services\\": "services/"
        },
        "classmap": ["models/"],
        "files": ["lib/functions.php"]
    },
    "config": {
        "sort-packages": true
    }
}
