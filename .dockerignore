# Keep the build context lean and secrets out of the image.
.git
.github
.gitignore
.claude
node_modules
vendor
database/*.db
database/*.sqlite
database/log
storage/logs/*
# Real (gitignored) config + EVERY connector secret (shopify/stripe/broker/…) —
# the entrypoint seeds config from *.example.ini on first boot. Broad ignore so a new
# connector's .ini can never leak into an image layer; keep only the examples.
conf/*.ini
!conf/*.example.ini
# User data lives in mounted volumes, never in the image (would bake in files + go stale).
uploads/
public/uploads/
public/store/
data/
*.md
tests
