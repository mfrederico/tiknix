{
    "slug": "shopify-inventory",
    "name": "Shopify inventory \u2192 local tables",
    "description": "Pull every product from the connected Shopify store, page by page, and store products plus one row per variant with its stock level. Re-running updates rather than duplicating.",
    "max_steps": 4000,
    "expose_as_tool": false,
    "expose_as_api": false,
    "trigger": [],
    "context_schema": {
        "query": {
            "type": "string",
            "required": false,
            "description": "Optional Shopify product filter, e.g. \"status:active\" or \"vendor:Acme\". Empty pulls everything."
        },
        "page_size": {
            "type": "integer",
            "required": false,
            "description": "Products per page, 1-250. Defaults to 250 (Shopify's maximum) \u2014 fewer pages means fewer steps against the pipeline's step budget."
        },
        "store": {
            "type": "string",
            "required": false,
            "description": "Which connected store, when more than one Shopify store is connected \u2014 the shop domain, e.g. acme.myshopify.com. Leave empty when there is only one."
        }
    },
    "steps": [
        {
            "name": "fetch",
            "type": "connection",
            "config": {
                "connector": "shopify",
                "environment": "production",
                "account": "{context.store|}",
                "tool": "graphql",
                "arguments": {
                    "query": "query Products($first: Int!, $after: String, $q: String) {\n  products(first: $first, after: $after, query: $q) {\n    pageInfo { hasNextPage endCursor }\n    edges {\n      node {\n        id\n        title\n        handle\n        status\n        vendor\n        productType\n        totalInventory\n        updatedAt\n        variants(first: 100) {\n          edges { node { id title sku price inventoryQuantity } }\n        }\n      }\n    }\n  }\n}",
                    "variables": {
                        "first": "{context.page_size|250}",
                        "after": "{cursor.output|null}",
                        "q": "{context.query|}"
                    }
                }
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "map_products",
            "type": "transform",
            "config": {
                "mode": "map",
                "input": "{fetch.output.data.products.edges}",
                "fields": {
                    "product_eid": "node.id",
                    "title": "node.title",
                    "handle": "node.handle",
                    "status": "node.status",
                    "vendor": "node.vendor",
                    "product_type": "node.productType",
                    "total_inventory": "node.totalInventory",
                    "updated_at_shop": "node.updatedAt"
                }
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "store_products",
            "type": "upsert",
            "config": {
                "table": "shopifyproduct",
                "rows": "{map_products.output}",
                "key": [
                    "product_eid"
                ]
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "map_variants",
            "type": "transform",
            "config": {
                "mode": "flatten",
                "input": "{fetch.output.data.products.edges}",
                "path": "node.variants.edges",
                "keep": {
                    "product_eid": "node.id",
                    "product_title": "node.title"
                },
                "fields": {
                    "variant_eid": "node.id",
                    "variant_title": "node.title",
                    "sku": "node.sku",
                    "price": "node.price",
                    "stock": "node.inventoryQuantity"
                }
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "store_variants",
            "type": "upsert",
            "config": {
                "table": "shopifyvariant",
                "rows": "{map_variants.output}",
                "key": [
                    "variant_eid"
                ]
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "cursor",
            "type": "transform",
            "config": {
                "mode": "jsonpath",
                "input": "{fetch.output}",
                "path": "data.products.pageInfo.endCursor"
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "more_pages",
            "type": "branch",
            "config": {
                "left": "{fetch.output.data.products.pageInfo.hasNextPage}",
                "op": "truthy"
            },
            "on_success": "goto:fetch",
            "on_fail": "next"
        },
        {
            "name": "done",
            "type": "transform",
            "config": {
                "mode": "template",
                "input": "Inventory sync complete."
            },
            "on_success": "exit",
            "on_fail": "exit"
        }
    ]
}
